# Archivo .env para Servidor de Procesamiento de Imágenes
# Copiar este archivo a la instancia EC2 (18.116.117.140)

# Puerto del servidor de imágenes
PUERTO_IMG=8000

# URL de la API principal (main.py)
# Cambiar a la IP/dominio real de tu servidor principal
API_PRINCIPAL_URL=http://3.148.29.34/reportes/

# Modelo YOLO a utilizar
# Opciones: yolov8n.pt (nano, más rápido), yolov8s.pt (small), yolov8m.pt (medium)
MODELO_YOLO=yolov8n.pt

# Confianza mínima para detecciones (0.0 - 1.0)
# Valores más altos = menos detecciones pero más precisas
CONFIANZA_MIN=0.45

# Modo de desarrollo (opcional)
# DEBUG=1
