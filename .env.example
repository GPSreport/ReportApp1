# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reportes_gps
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Configuración de AWS SES (Simple Email Service)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_SES_SENDER_EMAIL=noreply@tudominio.com

# IMPORTANTE: 
# 1. El email remitente (AWS_SES_SENDER_EMAIL) debe estar verificado en AWS SES
# 2. Para AWS Free Tier, también necesitas verificar los emails receptores
# 3. Las credenciales AWS deben tener permisos para enviar emails via SES